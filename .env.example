# Copy to .env (git-ignored; read from the current directory, then from the checkout) or export in your shell.
# A model can be run without any key; keys are needed to judge (the first block) and to sample vendor systems
# (the last blocks).

# Where the benchmark media lives: assets are at $STREAMEVAL_DATA/v1/<file>. Default: data/ in the checkout.
# A relative path is relative to the directory the command runs in.
#STREAMEVAL_DATA=/path/to/data

# Judge: any OpenAI-compatible chat-completions endpoint. The official v1 judge is qwen3.8-max-0902 on DashScope;
# another model gives diagnostic scores that are not comparable with the leaderboard.
# DASHSCOPE_API_KEY is the default key of the judge, the ASR and the dialogue stack; STREAMEVAL_JUDGE_API_KEY,
# STREAMEVAL_ASR_API_KEY and STREAMEVAL_DIALOGUE_API_KEY override it per endpoint.
STREAMEVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STREAMEVAL_JUDGE_MODEL=qwen3.8-max-0902
DASHSCOPE_API_KEY=
#STREAMEVAL_JUDGE_API_KEY=
# second vision judge, used for Identity only (same endpoint and key)
#STREAMEVAL_SECOND_JUDGE_MODEL=qwen3-vl-plus

# Judge for A-V Sync (avatar tracks only): rates lip opening on face crops (images only, it never hears the
# audio); OpenAI Responses API, base URL ".../v1" or the full ".../responses" endpoint. The official v1 judge is
# gpt-6-astra. Without it the other metrics are judged and A-V Sync stays undetermined.
STREAMEVAL_AV_JUDGE_BASE_URL=
STREAMEVAL_AV_JUDGE_MODEL=gpt-6-astra
STREAMEVAL_AV_JUDGE_API_KEY=

# ASR for dialogue answers: an OpenAI-compatible chat-completions endpoint that takes `input_audio`
STREAMEVAL_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STREAMEVAL_ASR_MODEL=qwen3-asr-flash
#STREAMEVAL_ASR_API_KEY=

# Dialogue stack of composition avatars (ASR -> LLM -> streaming TTS, docs/add_a_model.md); defaults are the v1
# models. STREAMEVAL_DIALOGUE_STACK=offline replaces it by a network-free stand-in (fixed replies, tone speech)
# for trying a renderer without a key; such runs are not comparable with anything.
#STREAMEVAL_DIALOGUE_BASE_URL=
#STREAMEVAL_DIALOGUE_API_KEY=
#STREAMEVAL_DIALOGUE_ASR=
#STREAMEVAL_DIALOGUE_LLM=
#STREAMEVAL_DIALOGUE_TTS=
#STREAMEVAL_DIALOGUE_VOICE=
#STREAMEVAL_DIALOGUE_STACK=

# Models and servers (docs/add_a_model.md)
# extra system.json files or folders, ":"-separated
#STREAMEVAL_MODELS=
# where models/selfhost/*/setup.sh put code, environments and weights (default ~/.cache/streameval/models)
#STREAMEVAL_MODEL_ROOT=
# interpreter for a server command that starts with "python" (default: the harness's own)
#STREAMEVAL_SERVER_PYTHON=
# optional proxy used by models/selfhost/*/setup.sh for downloads
#STREAMEVAL_PROXY=
# the checkout, when the package is not installed from it with `pip install -e .`
#STREAMEVAL_ROOT=

# Vendor session backends (models/providers/; only needed to sample those systems yourself). Keys stay in this process: the browser page only receives a short-lived token the backend mints.
# Browser runtime: cd streameval/providers/js && npm ci && npx playwright install chromium
STREAMEVAL_NODE=node
STREAMEVAL_BROWSER_RUNTIME=
STREAMEVAL_CHROMIUM=
XMAX_API_KEY=
XMAX_REGION=global
# Vidu S2 (models/providers/vidu): the account key, the regional origin (https://api.vidu.cn or https://api.vidu.com),
# and the pinned AliRTC Web SDK 7.1.9 file (default ~/.cache/streameval/providers/vidu/aliyun-rtc-sdk-7.1.9.js);
# vidu_s2_editing_t2i also needs DASHSCOPE_API_KEY (qwen-image references)
VIDU_S2_API_KEY=
VIDU_S2_API_BASE=https://api.vidu.cn
# a session is refused below this account balance (default 100000 credits)
#VIDU_S2_CREDIT_FLOOR=
STREAMEVAL_VIDU_SDK=

# RTC avatars (models/providers/{runway,liveavatar,tavus}; pip install -e .[rtc])
RUNWAYML_API_SECRET=
# one account avatar per benchmark portrait is created once and its id cached here
STREAMEVAL_RUNWAY_AVATARS=~/.cache/streameval/providers/runway_avatars
LIVEAVATAR_API_KEY=
TAVUS_API_KEY=
# the persona you created from models/providers/tavus/pal_v1.json `request`
TAVUS_PAL_ID=
# 1: run even if the live persona differs from the frozen one (recorded; no longer the v1 configuration)
TAVUS_ALLOW_PAL_DRIFT=

# Vivix A1 audio dialogue (optional .[vivix] dependencies)
VIVIX_API_KEY=
