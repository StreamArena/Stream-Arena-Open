  "sa.v1.107.portrait": {
   "bytes": 1465503,
   "kind": "image",
   "path": "v1/images/099.png",
   "role": "portrait",
   "sha256": "e690b5a728e697c504166945d5e5736ec437ea19fbb035c5d99d953d973bff57"
  },
  "sa.v1.107.user_audio.u1": {
   "bytes": 84524,
   "kind": "audio",
   "path": "v1/audio/011.wav",
   "role": "user_audio",
   "script": "How many cots are in Zone Three?",
   "sha256": "9c610fced3f1305af3a5171eab1cbe3388caa3a3643381cf520c47f3df499f97"
  },
  "sa.v1.107.user_audio.u2": {
   "bytes": 161324,
   "kind": "audio",
   "path": "v1/audio/012.wav",
   "role": "user_audio",
   "script": "Wait, I meant Zone Five, not Three.",
   "sha256": "99e97b2fa971befd9f876e4ecf52e861702af13850bb7d232729960ad6ced88f"
  },
  "sa.v1.108.portrait": {
   "bytes": 1580869,
   "kind": "image",
   "path": "v1/images/100.png",
   "role": "portrait",
   "sha256": "28689fa4f71967a1368d18a1e86ed18843020cd93824c17114893055039a3ec9"
  },
  "sa.v1.108.user_audio.u1": {
   "bytes": 145964,
   "kind": "audio",
   "path": "v1/audio/013.wav",
   "role": "user_audio",
   "script": "Route thermal blankets to Bleached Atoll and Deep Shelf.",
   "sha256": "db8d60c6097265310445d2c249c0c47b20a24e7c737b71f694bdd6dc26af87c9"
  },
  "sa.v1.108.user_audio.u2": {
   "bytes": 153644,
   "kind": "audio",
   "path": "v1/audio/014.wav",
   "role": "user_audio",
   "script": "Wait, Bleached Atoll is evacuated, drop it.",
   "sha256": "baf1e9ee8fc2dfc51cd8ef0ddb3ea7e8993ddc56a6cd55ace1f71f2a09d32762"
  },
  "sa.v1.115.portrait": {
   "bytes": 1324983,
   "kind": "image",
   "path": "v1/images/107.png",
   "role": "portrait",
   "sha256": "899f9bb5258a61cf15c2e0fed97f9d5bf252ad63cdbcfe752763f1836a7cf336"
  },
  "sa.v1.115.user_audio.u1": {
   "bytes": 90284,
   "kind": "audio",
   "path": "v1/audio/027.wav",
   "role": "user_audio",
   "script": "Could you put my duffel bag in the—",
   "sha256": "9a7a7e1303a0fafb1a3de040a93eac40769cff07a04e7712db6529dccab8c0e9"
  },
  "sa.v1.115.user_audio.u2": {
   "bytes": 117164,
   "kind": "audio",
   "path": "v1/audio/028.wav",
   "role": "user_audio",
   "script": "Actually no, it is my cello case.",
   "sha256": "298f6f31011d8b3823e34797b36df46efe27c20d7af163b9c8cf44dca0342702"
  },
  "sa.v1.116.portrait": {
   "bytes": 1827569,
   "kind": "image",
   "path": "v1/images/108.png",
   "role": "portrait",
   "sha256": "893f8d3945c0393a1f6202158d831279538c6be667943abb50ee1e2af0eb7826"
  },
  "sa.v1.116.user_audio.u1": {
   "bytes": 111404,
   "kind": "audio",
   "path": "v1/audio/029.wav",
   "role": "user_audio",
   "script": "Are the dinosaur hall sensors off for maintenance?",
   "sha256": "4203f5c0ff6788c497f8078fe5b9cfb38e9a79814ad1cbaa53ba6b92e2e418de"
  },
  "sa.v1.116.user_audio.u2": {
   "bytes": 161324,
   "kind": "audio",
   "path": "v1/audio/030.wav",
   "role": "user_audio",
   "script": "Wait, the status update says those sensors are fully armed.",
   "sha256": "72267714efe8e4eabf5b97c08a628fe36aae25355b0b83cffe41dd1946d44bbd"
  },
  "sa.v1.123.portrait": {
   "bytes": 1551766,
   "kind": "image",
   "path": "v1/images/115.png",
   "role": "portrait",
   "sha256": "48672c78d5c4bf090f181712f9887b8d37b0466a84d9d76ed218efef749fbd74"
  },
  "sa.v1.123.user_audio.u1": {
   "bytes": 238124,
   "kind": "audio",
   "path": "v1/audio/047.wav",
   "role": "user_audio",
   "script": "I need a floodplain planting plan for our south field, but everything has to be organic.",
   "sha256": "476b5e9726cd8b99b6945aeda30a087583303dcdcb4c314aca638246da620b81"
  },
  "sa.v1.123.user_audio.u2": {
   "bytes": 222764,
   "kind": "audio",
   "path": "v1/audio/048.wav",
   "role": "user_audio",
   "script": "Wait, skip the rice—let's do sorghum instead, still organic though.",
   "sha256": "c5b497ba9803f3d5e2cd5b7f7ee28d55789d6d02ee0d8bbd409dd4500a9e6a4e"
  },
  "sa.v1.124.portrait": {
   "bytes": 1508019,
   "kind": "image",
   "path": "v1/images/116.png",
   "role": "portrait",
   "sha256": "0f7a77d71ef5ab18131780a4ddc1d0cb0b797ae360ea2dfd229a244c2d3f7402"
  },
  "sa.v1.124.user_audio.u1": {
   "bytes": 130604,
   "kind": "audio",
   "path": "v1/audio/049.wav",
   "role": "user_audio",
   "script": "Which mapped route might suit our survey?",
   "sha256": "33092421460c5a30924045d5c1f948a32cca5b9cf6099f5b2449fb819872d432"
  },
  "sa.v1.124.user_audio.u2": {
   "bytes": 203564,
   "kind": "audio",
   "path": "v1/audio/050.wav",
   "role": "user_audio",
   "script": "Wait, hold on—our hull is rated to only two thousand meters.",
   "sha256": "afe9ee5a9548c34e5afb6fcc0894a1142655f3a1d469bfeee729133eb33732a4"
  },
  "sa.v1.131.portrait": {
   "bytes": 1456108,
   "kind": "image",
   "path": "v1/images/123.png",
   "role": "portrait",
   "sha256": "75a0a4531f0a1f2fd0b606a8e72eacfe2fba67378bea7c4924c03c8e333ae601"
  },
  "sa.v1.131.user_audio.u1": {
   "bytes": 190124,
   "kind": "audio",
   "path": "v1/audio/070.wav",
   "role": "user_audio",
   "script": "Book the north array for Dr. Lorn at twenty-two hundred hours.",
   "sha256": "236208ad7f6f75ebd26bc6677c20c286714f3eb23d52d2ae9df763e7ab3cb99a"
  },
  "sa.v1.131.user_audio.u2": {
   "bytes": 105644,
   "kind": "audio",
   "path": "v1/audio/071.wav",
   "role": "user_audio",
   "script": "Wait no make it twenty-three hundred.",
   "sha256": "a3aa727be3c13e44e9a62e294edf28b780eba6a804e495a6083736ce47be349b"
  },
  "sa.v1.131.user_audio.u3": {
   "bytes": 147884,
   "kind": "audio",
   "path": "v1/audio/072.wav",
   "role": "user_audio",
   "script": "Actually scratch that lock it in at midnight instead.",
   "sha256": "e88527364a2915a803a5dc668ef3d9dd72a10ce5459ac79b2b86222ae2cc71f7"
  },
  "sa.v1.132.portrait": {
   "bytes": 1957770,
   "kind": "image",
   "path": "v1/images/124.png",
   "role": "portrait",
   "sha256": "bb71be42845173c18f99885225f206ef923fc9ebe443c3cd3437574165492ad1"
  },
  "sa.v1.132.user_audio.u1": {
   "bytes": 165164,
   "kind": "audio",
   "path": "v1/audio/073.wav",
   "role": "user_audio",
   "script": "Walk me through the three-step storm protocol for the north ridge.",
   "sha256": "234a03b68d3e6026a44901dbf9617950da8e65daeee206b03055bb16032594a0"
  },
  "sa.v1.132.user_audio.u2": {
   "bytes": 268844,
   "kind": "audio",
   "path": "v1/audio/074.wav",
   "role": "user_audio",
   "script": "Wait, the north ridge shelter is Bunker Seven now, not Bunker Four. Go on.",
   "sha256": "f44af3e3f10faf0974c78660fd35415a541aa4571605eab4537c3aad8b9d6d53"
  },
  "sa.v1.139.portrait": {
   "bytes": 1509228,
   "kind": "image",
   "path": "v1/images/131.png",
   "role": "portrait",
   "sha256": "60f0ecaeab3304dcee340920b1c50f2051716c859cba74daa066ec5184317cda"
  },
  "sa.v1.139.user_audio.u1": {
   "bytes": 157484,
   "kind": "audio",
   "path": "v1/audio/110.wav",
   "role": "user_audio",
   "script": "Go ahead and read the outgoing shift summary for Ridge Station.",
   "sha256": "f0b0f36bd5c488d7a64a145b324b855be6a06e621219d3f37eca2787d8645058"
  },
  "sa.v1.139.user_audio.u2": {
   "bytes": 311084,
   "kind": "audio",
   "path": "v1/audio/111.wav",
   "role": "user_audio",
   "script": "Wait, stop. The wind speed is actually forty knots from the southwest, not twenty from the north.",
   "sha256": "04a04d85666ccd57fa22c565c721e7e9230945eadd201952e2b9accee384093a"
  },
  "sa.v1.139.user_audio.u3": {
   "bytes": 238124,
   "kind": "audio",
   "path": "v1/audio/112.wav",
   "role": "user_audio",
   "script": "Okay, given that change, which version of the evening log should I file?",
   "sha256": "e065962c0caa73e565863042679bf02c7db75e6c1fbbf9ba2e7247955edecd61"
  },
  "sa.v1.139.user_audio.u4": {
   "bytes": 172844,
   "kind": "audio",
   "path": "v1/audio/113.wav",
   "role": "user_audio",
   "script": "Also note the humidity dropped to eight percent ten minutes ago.",
   "sha256": "0acd6799e13e56db8ffbf004438f2f3ed1fcb0da1ece92a91c3a70de626413ae"
  },
  "sa.v1.139.user_audio.u5": {
   "bytes": 203564,
   "kind": "audio",
   "path": "v1/audio/114.wav",
   "role": "user_audio",
   "script": "And the access road is closed due to a fallen oak near marker six.",
   "sha256": "365dd1954a2557b66a74fa19e24bf046e09247b1b07a14f000c4997e252f0e87"
  },
  "sa.v1.139.user_audio.u6": {
   "bytes": 222764,
   "kind": "audio",
   "path": "v1/audio/115.wav",
   "role": "user_audio",
   "script": "One more thing: the relief driver is now Tomas, not Elena.",
   "sha256": "b46d03c648025eaa28db7bf94fe5965fb041f123b68a626cd53ed4f2c829f3b3"
  },
  "sa.v1.139.user_audio.u7": {
   "bytes": 184364,
   "kind": "audio",
   "path": "v1/audio/116.wav",
   "role": "user_audio",
   "script": "So confirm everything you have for the final handover packet.",
   "sha256": "824144450ca2702a34536b2ad11e987a3aa08404e882ee75f1958301bdc2d8bc"
  },
  "sa.v1.140.portrait": {
   "bytes": 1477515,
   "kind": "image",
   "path": "v1/images/132.png",
   "role": "portrait",
   "sha256": "2f604584ea54f44338cc674aeb860895f7ecdd18e620a51479408030b9f537a2"
  },
  "sa.v1.140.user_audio.u1": {
   "bytes": 126764,
   "kind": "audio",
   "path": "v1/audio/117.wav",
   "role": "user_audio",
   "script": "What barrier method should we use for the north bank?",
   "sha256": "ff7164dfb27b0a2f9fa5cbb2ef08952cd22fa28be5068b2a095a586c44693ced"
  },
  "sa.v1.140.user_audio.u2": {
   "bytes": 265004,
   "kind": "audio",
   "path": "v1/audio/118.wav",
   "role": "user_audio",
   "script": "Hold on, archived directive seven says we must use permeable barriers there, not silt fences.",
   "sha256": "b2c1ae78396d480cdc590329bf414738b7744760ad9616eadb0f2484a1619057"
  },
  "sa.v1.140.user_audio.u3": {
   "bytes": 195884,
   "kind": "audio",
   "path": "v1/audio/119.wav",
   "role": "user_audio",
   "script": "Okay, so what about the south bank vegetation stabilization?",
   "sha256": "844dd8feb8252f9c2857d92a8be475193924dd6192a422f135432f2c57bcd6e9"
  },
  "sa.v1.140.user_audio.u4": {
   "bytes": 249644,
   "kind": "audio",
   "path": "v1/audio/120.wav",
   "role": "user_audio",
   "script": "Wait, doesn't archived directive seven also require native willow stakes instead of coir logs?",
   "sha256": "a0db84e9b6e943b28b30bee6b804b5fc6f0950234820555bd140a23a95e5d5ef"
  },
  "sa.v1.140.user_audio.u5": {
   "bytes": 161324,
   "kind": "audio",
   "path": "v1/audio/121.wav",
   "role": "user_audio",
   "script": "Got it. Summarize the final plan for both banks then.",
   "sha256": "72cccef859dc1de6e886191cfdf8e226c33390b7a2756a11475fe22d16d97ace"
  },
  "sa.v1.140.user_audio.u6": {
   "bytes": 195884,
   "kind": "audio",
   "path": "v1/audio/122.wav",
   "role": "user_audio",
   "script": "Just confirming, are we ignoring current municipal protocols entirely now?",
   "sha256": "af47c5144f852cb917342b7949c8d23177d235560db8b57583f514c0321865b3"
  },
